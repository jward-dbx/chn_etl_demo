{
  "datasets": [
    {
      "name": "ds_er_operational_hourly",
      "displayName": "ER Operational (Hourly)",
      "queryLines": [
        "SELECT ",
        "  site, ",
        "  region, ",
        "  unit, ",
        "  date, ",
        "  hour_of_day, ",
        "  is_weekend, ",
        "  CASE WHEN is_weekend THEN 'Weekend' ELSE 'Weekday' END AS weekend_vs_weekday, ",
        "  CASE dayofweek(date) ",
        "    WHEN 1 THEN 'Sun' ",
        "    WHEN 2 THEN 'Mon' ",
        "    WHEN 3 THEN 'Tue' ",
        "    WHEN 4 THEN 'Wed' ",
        "    WHEN 5 THEN 'Thu' ",
        "    WHEN 6 THEN 'Fri' ",
        "    WHEN 7 THEN 'Sat' ",
        "    ELSE 'Unknown' ",
        "  END AS day_of_week, ",
        "  arrivals, ",
        "  throughput, ",
        "  queue_length_median, ",
        "  door_to_triage_median, ",
        "  door_to_provider_median, ",
        "  effective_staffing_hours, ",
        "  nurse_to_patient_ratio, ",
        "  occupancy_pct ",
        "FROM demo_generator.justin_ward_demo_ward_patient_readmission.gold_er_operational_hourly "
      ]
    },
    {
      "name": "ds_er_quality_daily",
      "displayName": "ER Quality (Daily)",
      "queryLines": [
        "SELECT ",
        "  site, ",
        "  region, ",
        "  unit, ",
        "  date, ",
        "  is_weekend, ",
        "  CASE WHEN is_weekend THEN 'Weekend' ELSE 'Weekday' END AS weekend_vs_weekday, ",
        "  day_of_week_num, ",
        "  CASE day_of_week_num ",
        "    WHEN 1 THEN 'Mon' ",
        "    WHEN 2 THEN 'Tue' ",
        "    WHEN 3 THEN 'Wed' ",
        "    WHEN 4 THEN 'Thu' ",
        "    WHEN 5 THEN 'Fri' ",
        "    WHEN 6 THEN 'Sat' ",
        "    WHEN 7 THEN 'Sun' ",
        "    ELSE 'Unknown' ",
        "  END AS day_of_week, ",
        "  visits_total, ",
        "  throughput_daily, ",
        "  CAST(lwbs_rate AS DOUBLE) AS lwbs_rate, ",
        "  median_triage_wait_minutes, ",
        "  median_door_to_provider_minutes, ",
        "  satisfaction_overall_avg ",
        "FROM demo_generator.justin_ward_demo_ward_patient_readmission.gold_er_quality_daily "
      ]
    },
    {
      "name": "ds_er_finance_daily",
      "displayName": "ER Finance (Daily)",
      "queryLines": [
        "SELECT ",
        "  site, ",
        "  region, ",
        "  unit, ",
        "  date, ",
        "  is_weekend, ",
        "  CASE WHEN is_weekend THEN 'Weekend' ELSE 'Weekday' END AS weekend_vs_weekday, ",
        "  overtime_hours_sum, ",
        "  cost_per_visit_avg, ",
        "  CAST(reimbursement_at_risk_usd AS DOUBLE) AS reimbursement_at_risk_usd, ",
        "  CAST(cumulative_reimbursement_at_risk_usd AS DOUBLE) AS cumulative_reimbursement_at_risk_usd ",
        "FROM demo_generator.justin_ward_demo_ward_patient_readmission.gold_er_finance_daily "
      ]
    },
    {
      "name": "ds_er_staffing_daily",
      "displayName": "ER Staffing (Daily)",
      "queryLines": [
        "SELECT ",
        "  s.site, ",
        "  s.region, ",
        "  s.unit, ",
        "  s.date, ",
        "  s.is_weekend, ",
        "  CASE WHEN s.is_weekend THEN 'Weekend' ELSE 'Weekday' END AS weekend_vs_weekday, ",
        "  s.role, ",
        "  s.scheduled_hours, ",
        "  s.effective_hours, ",
        "  CAST(s.sick_leave_rate AS DOUBLE) AS sick_leave_rate, ",
        "  s.avg_nurse_to_patient_ratio, ",
        "  s.coverage_gap_flag ",
        "FROM demo_generator.justin_ward_demo_ward_patient_readmission.gold_er_staffing_daily s "
      ]
    },
    {
      "name": "ds_er_staffing_finance_notes_daily",
      "displayName": "ER Staffing + Finance + HR Notes (Daily)",
      "queryLines": [
        "WITH hr_notes AS ( ",
        "  SELECT ",
        "    site, ",
        "    unit, ",
        "    shift_date AS date, ",
        "    role, ",
        "    MAX(NULLIF(change_log_note, '')) AS notes ",
        "  FROM demo_generator.justin_ward_demo_ward_patient_readmission.silver_hr_shifts_and_sickleave ",
        "  GROUP BY site, unit, shift_date, role ",
        ") ",
        "SELECT ",
        "  s.date, ",
        "  s.site, ",
        "  s.region, ",
        "  s.unit, ",
        "  s.is_weekend, ",
        "  CASE WHEN s.is_weekend THEN 'Weekend' ELSE 'Weekday' END AS weekend_vs_weekday, ",
        "  s.role, ",
        "  CAST(s.sick_leave_rate AS DOUBLE) AS sick_leave_rate, ",
        "  COALESCE(f.overtime_hours_sum, 0.0) AS overtime_hours, ",
        "  s.coverage_gap_flag, ",
        "  COALESCE(n.notes, '') AS notes ",
        "FROM demo_generator.justin_ward_demo_ward_patient_readmission.gold_er_staffing_daily s ",
        "LEFT JOIN demo_generator.justin_ward_demo_ward_patient_readmission.gold_er_finance_daily f ",
        "  ON f.site = s.site AND f.unit = s.unit AND f.date = s.date ",
        "LEFT JOIN hr_notes n ",
        "  ON n.site = s.site AND n.unit = s.unit AND n.date = s.date AND n.role = s.role "
      ]
    },
    {
      "name": "ds_kpi_visits_last_30d",
      "displayName": "KPI \u2014 Visits (Last 30 Days)",
      "queryLines": [
        "SELECT ",
        "  SUM(arrivals) AS visits_last_30d ",
        "FROM demo_generator.justin_ward_demo_ward_patient_readmission.gold_er_operational_hourly ",
        "WHERE date >= date_sub((SELECT MAX(date) FROM demo_generator.justin_ward_demo_ward_patient_readmission.gold_er_operational_hourly), 29) "
      ]
    },
    {
      "name": "ds_kpi_lwbs_current_week",
      "displayName": "KPI \u2014 LWBS Rate (Current Week)",
      "queryLines": [
        "SELECT ",
        "  AVG(CAST(lwbs_rate AS DOUBLE)) AS lwbs_rate_current_week ",
        "FROM demo_generator.justin_ward_demo_ward_patient_readmission.gold_er_quality_daily ",
        "WHERE date >= DATE_TRUNC('WEEK', (SELECT MAX(date) FROM demo_generator.justin_ward_demo_ward_patient_readmission.gold_er_quality_daily)) "
      ]
    },
    {
      "name": "ds_kpi_dtp_current_week",
      "displayName": "KPI \u2014 Median Door-to-Provider (Current Week)",
      "queryLines": [
        "SELECT ",
        "  AVG(median_door_to_provider_minutes) AS median_door_to_provider_current_week_minutes ",
        "FROM demo_generator.justin_ward_demo_ward_patient_readmission.gold_er_quality_daily ",
        "WHERE date >= DATE_TRUNC('WEEK', (SELECT MAX(date) FROM demo_generator.justin_ward_demo_ward_patient_readmission.gold_er_quality_daily)) "
      ]
    },
    {
      "name": "ds_kpi_overtime_mtd",
      "displayName": "KPI \u2014 Overtime Hours (MTD)",
      "queryLines": [
        "SELECT ",
        "  SUM(overtime_hours_sum) AS overtime_hours_mtd ",
        "FROM demo_generator.justin_ward_demo_ward_patient_readmission.gold_er_finance_daily ",
        "WHERE date >= DATE_TRUNC('MONTH', (SELECT MAX(date) FROM demo_generator.justin_ward_demo_ward_patient_readmission.gold_er_finance_daily)) "
      ]
    },
    {
      "name": "ds_kpi_reimb_at_risk_mtd",
      "displayName": "KPI \u2014 Reimbursement at Risk (MTD)",
      "queryLines": [
        "SELECT ",
        "  SUM(CAST(reimbursement_at_risk_usd AS DOUBLE)) AS reimbursement_at_risk_mtd_usd ",
        "FROM demo_generator.justin_ward_demo_ward_patient_readmission.gold_er_finance_daily ",
        "WHERE date >= DATE_TRUNC('MONTH', (SELECT MAX(date) FROM demo_generator.justin_ward_demo_ward_patient_readmission.gold_er_finance_daily)) "
      ]
    }
  ],
