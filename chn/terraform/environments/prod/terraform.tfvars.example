# Production Environment Configuration
# Copy this file to terraform.tfvars and update with actual values

# Environment
environment = "prod"

# SQL Server Connection Configuration
sqlserver_connection_name = "conn_asqldb_awa_prod"
sqlserver_connection_comment = "SQL Server federation connection to Adventure Works database (production)"

# SQL Server Credentials and Endpoint
sqlserver_host          = "chn-prod.database.windows.net"
sqlserver_port          = "1433"
sqlserver_user          = "admin_chn_prod"
sqlserver_password      = "CHANGE_ME"  # Use secure secret management
sqlserver_database_name = "adventure-works-prod"

# Foreign Catalog Configuration - Database A
sqlserver_catalog_name    = "conn_asqldb_awa_catalog_prod"
sqlserver_catalog_comment = "Foreign catalog mirroring Adventure Works SQL Server database A (production)"
catalog_isolation_mode    = "OPEN"
catalog_owner             = "justin.ward@databricks.com"

# Foreign Catalog Configuration - Database B
sqlserver_catalog_name_b    = "conn_asqldb_awb_catalog_prod"
sqlserver_catalog_comment_b = "Foreign catalog mirroring Adventure Works SQL Server database B (production)"
sqlserver_database_name_b   = "adventure-works-b"

# Storage Credential Configuration
storage_credential_name    = "sc-chn-prod-storage"
storage_credential_comment = "Storage credential for CHN production Unity Catalog access"
# Note: Update with production access connector ID
azure_access_connector_id  = "/subscriptions/SUBSCRIPTION_ID/resourceGroups/RESOURCE_GROUP/providers/Microsoft.Databricks/accessConnectors/ACCESS_CONNECTOR_NAME"

# External Location Configuration
external_location_name    = "el-chn-prod-unity-catalog"
external_location_comment = "External location for CHN production Unity Catalog data"
# Note: Update with production storage account and container
external_location_url     = "abfss://CONTAINER@STORAGE_ACCOUNT.dfs.core.windows.net/"

# Schema Configuration
schema_catalog_name         = "dbx_chn_ward_demo_prod"
schema_ct_enabled_name      = "sqlserver_ct_enabled"
schema_ct_enabled_comment   = "SQL Server data schema with change tracking enabled (production)"
schema_ct_disabled_name     = "sqlserver_ct_disabled"
schema_ct_disabled_comment  = "SQL Server data schema with change tracking disabled (production)"

# Additional connection options
sqlserver_additional_options = {
  applicationIntent      = "ReadOnly"
  trustServerCertificate = "true"
}

# Additional properties
sqlserver_properties = {
  team    = "data-engineering"
  project = "chn-etl-demo"
  tier    = "production"
}
