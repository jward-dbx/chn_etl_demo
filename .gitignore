.databrickscfg.bak
.dbclient/
.docker/
.gitconfig
.lesshst
.local/
.localized
.npm/
.profile
.redhat/
.streamlit/
.swiftpm/
.terraform.d/
.vscode/
.zcompdump
.zprofile
.zsh_history
.zsh_sessions/
.zshrc

# Exclude common directories
Applications/
Desktop/
Documents/
Downloads/
Library/
Movies/
Music/
Pictures/
Public/
Google Drive/

# Exclude other project directories (add more as needed)
!ccf/
!ccf_agent/
!claude_app/
!config.json.txt
!databricks-ml-oversight/
!dlt-meta/
!fhir_demo/
