# Ignore everything by default
/*

# But include the project directory
!/teladoc/
!/teladoc/**
!/teladoc/chronic_conditions/
!/teladoc/chronic_conditions/**
!/teladoc/chronic_conditions/demo_ward_clinical_assistant_dab_bundle/
!/teladoc/chronic_conditions/demo_ward_clinical_assistant_dab_bundle/**

# Exclude common system/user files
.bun/
.bash_history
.bashrc
.CFUserTextEncoding
.DS_Store
.Trash/
.cursor/
.codex/
.config/
.cups/
.databricks/
