            "path": "/Users/justin.ward@databricks.com/demo_ward_clinical_assistant/.bundle/ai_demo_generator_demo_demo_ward_clinical_assistant/resources/demo_ward_clinical_assistant - Chronic Care Ops \u0026 Risk Monitoring.lvdash.json",
            "serialized_dashboard": "{\n  \"datasets\": [\n    {\n      \"name\": \"ds_patients_active_counter\",\n      \"displayName\": \"KPI: Active CCM Patients\",\n      \"queryLines\": [\n        \"SELECT active_ccm_patients FROM ward_demo.justin_ward_demo_ward_clinical_assistant.gold_counter_active_patients ORDER BY active_ccm_patients DESC \"\n      ]\n    },\n    {\n      \"name\": \"ds_valid_readings_last7_counter\",\n      \"displayName\": \"KPI: Valid Readings Last 7 Days\",\n      \"queryLines\": [\n        \"SELECT valid_readings_last7 FROM ward_demo.justin_ward_demo_ward_clinical_assistant.gold_counter_valid_readings_last7 ORDER BY valid_readings_last7 DESC \"\n      ]\n    },\n    {\n      \"name\": \"ds_avg_daily_risk_high_last7_counter\",\n      \"displayName\": \"KPI: Avg Daily Risk (High Tier, Last 7)\",\n      \"queryLines\": [\n        \"SELECT avg_daily_risk_high_last7 FROM ward_demo.justin_ward_demo_ward_clinical_assistant.gold_counter_avg_daily_risk_high_last7 ORDER BY avg_daily_risk_high_last7 DESC \"\n      ]\n    },\n    {\n      \"name\": \"ds_care_actions_executed_last14_counter\",\n      \"displayName\": \"KPI: Care Actions Executed Last 14 Days\",\n      \"queryLines\": [\n        \"SELECT actions_executed_last14 FROM ward_demo.justin_ward_demo_ward_clinical_assistant.gold_counter_care_actions_executed_last14 ORDER BY actions_executed_last14 DESC \"\n      ]\n    },\n    {\n      \"name\": \"ds_device_ingestion_timeseries\",\n      \"displayName\": \"Device Ingestion Timeseries\",\n      \"queryLines\": [\n        \"SELECT date, region, device_type, readings_total, readings_valid, valid_rate, CASE WHEN date BETWEEN DATE('2025-10-02') AND DATE('2025-10-21') THEN true ELSE false END AS is_anomaly_window FROM ward_demo.justin_ward_demo_ward_clinical_assistant.gold_device_ingestion_timeseries ORDER BY date ASC, device_type ASC, region ASC \"\n      ]\n    },\n    {\n      \"name\": \"ds_bp_quality_timeseries\",\n      \"displayName\": \"BP Quality Timeseries\",\n      \"queryLines\": [\n        \"SELECT date, region, bp_readings, diastolic_missing, missing_rate_diastolic, CASE WHEN date BETWEEN DATE('2025-10-02') AND DATE('2025-10-21') THEN true ELSE false END AS is_anomaly_window FROM ward_demo.justin_ward_demo_ward_clinical_assistant.gold_bp_quality_timeseries ORDER BY date ASC, region ASC \"\n      ]\n    },\n    {\n      \"name\": \"ds_patient_risk_weekly\",\n      \"displayName\": \"Patient Risk Weekly\",\n      \"queryLines\": [\n        \"SELECT week_start, region, risk_tier, condition, avg_risk_score, patient_days FROM ward_demo.justin_ward_demo_ward_clinical_assistant.gold_patient_risk_weekly ORDER BY week_start ASC, region ASC, risk_tier ASC \"\n      ]\n    },\n    {\n      \"name\": \"ds_encounter_signal_timeseries\",\n      \"displayName\": \"Encounter Signals Timeseries\",\n      \"queryLines\": [\n        \"SELECT date, region, pct_notes_with_diet_non_adherence, pct_notes_with_med_adherence_issues, notes_count, CASE WHEN date BETWEEN DATE('2025-10-02') AND DATE('2025-10-21') THEN true ELSE false END AS is_anomaly_window FROM ward_demo.justin_ward_demo_ward_clinical_assistant.gold_encounter_signal_timeseries ORDER BY date ASC, region ASC \"\n      ]\n    },\n    {\n      \"name\": \"ds_care_actions_weekly\",\n      \"displayName\": \"Care Actions Weekly\",\n      \"queryLines\": [\n        \"SELECT week_start, region, condition, action_type, actions_total, actions_executed, execute_rate, avg_cost_usd, (actions_executed * avg_cost_usd) AS executed_cost_usd_est FROM ward_demo.justin_ward_demo_ward_clinical_assistant.gold_care_actions_weekly ORDER BY week_start ASC, region ASC, action_type ASC \"\n      ]\n    },\n    {\n      \"name\": \"ds_device_change_log\",\n      \"displayName\": \"Device Change Log\",\n      \"queryLines\": [\n        \"SELECT change_date, date, vendor, device_type, version, regions_scope, change_type, error_codes, notes FROM ward_demo.justin_ward_demo_ward_clinical_assistant.silver_device_change_log ORDER BY change_date DESC \"\n      ]\n    },\n    {\n      \"name\": \"ds_cumulative_care_cost\",\n      \"displayName\": \"Cumulative Care Cost\",\n      \"queryLines\": [\n        \"SELECT date, region, condition, executed_cost_usd, running_total_cost_usd FROM ward_demo.justin_ward_demo_ward_clinical_assistant.gold_cumulative_care_cost ORDER BY date ASC, region ASC \"\n      ]\n    }\n  ],\n  \"pages\": [\n    {\n      \"name\": \"clinical_ccm_monitoring\",\n      \"displayName\": \"Chronic Care Ops \u0026 Risk Monitoring\",\n      \"layout\": [\n        {\n          \"widget\": {\n            \"name\": \"header_main\",\n            \"multilineTextboxSpec\": {\n              \"lines\": [\n                \"# Chronic Care Ops \u0026 Risk Monitoring\\n\",\n                \"Executive monitoring of ingestion quality, encounter signals, risk, and care workload during the 2025-10-02..2025-10-21 firmware anomaly and staged recovery.\\n\"\n              ]\n            }\n          },\n          \"position\": {\n            \"x\": 0,\n            \"y\": 0,\n            \"width\": 6,\n            \"height\": 2\n          }\n        },\n        {\n          \"widget\": {\n            \"name\": \"kpi_active_patients\",\n            \"queries\": [\n              {\n                \"name\": \"main_query\",\n                \"query\": {\n                  \"datasetName\": \"ds_patients_active_counter\",\n                  \"fields\": [\n                    {\n                      \"name\": \"sum(active_ccm_patients)\",\n                      \"expression\": \"SUM(`active_ccm_patients`)\"\n                    }\n                  ],\n                  \"disaggregated\": false\n                }\n              }\n            ],\n            \"spec\": {\n              \"version\": 2,\n              \"widgetType\": \"counter\",\n              \"encodings\": {\n                \"value\": {\n                  \"fieldName\": \"sum(active_ccm_patients)\",\n                  \"displayName\": \"Active CCM Patients\",\n                  \"format\": {\n                    \"type\": \"number\",\n                    \"decimalPlaces\": {\n                      \"type\": \"max\",\n                      \"places\": 0\n                    }\n                  }\n                }\n              },\n              \"frame\": {\n                \"title\": \"Active CCM Patients\",\n                \"showTitle\": true,\n                \"description\": \"Currently enrolled CCM patients with device activity in the last 30 days.\",\n                \"showDescription\": true\n              }\n            }\n          },\n          \"position\": {\n            \"x\": 0,\n            \"y\": 2,\n            \"width\": 2,\n            \"height\": 3\n          }\n        },\n        {\n          \"widget\": {\n            \"name\": \"kpi_valid_readings_last7\",\n            \"queries\": [\n              {\n                \"name\": \"main_query\",\n                \"query\": {\n                  \"datasetName\": \"ds_valid_readings_last7_counter\",\n                  \"fields\": [\n                    {\n                      \"name\": \"sum(valid_readings_last7)\",\n                      \"expression\": \"SUM(`valid_readings_last7`)\"\n                    }\n                  ],\n                  \"disaggregated\": false\n                }\n              }\n            ],\n            \"spec\": {\n              \"version\": 2,\n              \"widgetType\": \"counter\",\n              \"encodings\": {\n                \"value\": {\n                  \"fieldName\": \"sum(valid_readings_last7)\",\n                  \"displayName\": \"Valid Device Readings (Last 7 Days)\",\n                  \"format\": {\n                    \"type\": \"number\",\n                    \"decimalPlaces\": {\n                      \"type\": \"max\",\n                      \"places\": 0\n                    }\n                  }\n                }\n              },\n              \"frame\": {\n                \"title\": \"Valid Device Readings (Last 7 Days)\",\n                \"showTitle\": true,\n                \"description\": \"Trailing 7-day valid readings across glucose, BP, and weight.\",\n                \"showDescription\": true\n              }\n            }\n          },\n          \"position\": {\n            \"x\": 2,\n            \"y\": 2,\n            \"width\": 2,\n            \"height\": 3\n          }\n        },\n        {\n          \"widget\": {\n            \"name\": \"kpi_avg_daily_risk_high_last7\",\n            \"queries\": [\n              {\n                \"name\": \"main_query\",\n                \"query\": {\n                  \"datasetName\": \"ds_avg_daily_risk_high_last7_counter\",\n                  \"fields\": [\n                    {\n                      \"name\": \"avg(avg_daily_risk_high_last7)\",\n                      \"expression\": \"AVG(`avg_daily_risk_high_last7`)\"\n                    }\n                  ],\n                  \"disaggregated\": false\n                }\n              }\n            ],\n            \"spec\": {\n              \"version\": 3,\n              \"widgetType\": \"counter\",\n              \"encodings\": {\n                \"value\": {\n                  \"fieldName\": \"avg(avg_daily_risk_high_last7)\",\n                  \"displayName\": \"Avg Daily Risk Score (High Tier)\",\n                  \"format\": {\n                    \"type\": \"number-percent\",\n                    \"decimalPlaces\": {\n                      \"type\": \"max\",\n                      \"places\": 1\n                    }\n                  }\n                }\n              },\n              \"frame\": {\n                \"title\": \"Avg Daily Risk Score (High Tier, Last 7 Days)\",\n                \"showTitle\": true,\n                \"description\": \"Average daily hospitalization risk for high-risk diabetics.\",\n                \"showDescription\": true\n              }\n            }\n          },\n          \"position\": {\n            \"x\": 4,\n            \"y\": 2,\n            \"width\": 1,\n            \"height\": 3\n          }\n        },\n        {\n          \"widget\": {\n            \"name\": \"kpi_actions_executed_last14\",\n            \"queries\": [\n              {\n                \"name\": \"main_query\",\n                \"query\": {\n                  \"datasetName\": \"ds_care_actions_executed_last14_counter\",\n                  \"fields\": [\n                    {\n                      \"name\": \"sum(actions_executed_last14)\",\n                      \"expression\": \"SUM(`actions_executed_last14`)\"\n                    }\n                  ],\n                  \"disaggregated\": false\n                }\n              }\n            ],\n            \"spec\": {\n              \"version\": 3,\n              \"widgetType\": \"counter\",\n              \"encodings\": {\n                \"value\": {\n                  \"fieldName\": \"sum(actions_executed_last14)\",\n                  \"displayName\": \"Care Actions Executed (Last 14 Days)\",\n                  \"format\": {\n                    \"type\": \"number\",\n                    \"decimalPlaces\": {\n                      \"type\": \"max\",\n                      \"places\": 0\n                    }\n                  }\n                }\n              },\n              \"frame\": {\n                \"title\": \"Care Actions Executed (Last 14 Days)\",\n                \"showTitle\": true,\n                \"description\": \"Sum of executed nurse outreach, medication review, nutrition check-in, and device troubleshoot actions.\",\n                \"showDescription\": true\n              }\n            }\n          },\n          \"position\": {\n            \"x\": 5,\n            \"y\": 2,\n            \"width\": 1,\n            \"height\": 3\n          }\n        },\n        {\n          \"widget\": {\n            \"name\": \"section_overview\",\n            \"multilineTextboxSpec\": {\n              \"lines\": [\n                \"## Incident Overview \u0026 Recovery Trace\\n\",\n                \"Post 2025-10-02 rollout, glucose valid readings dropped and BP diastolic missing spiked in Central/West. A 2025-10-12 config push restored most ingestion, with full normalization after the 2025-10-21 hotfix.\\n\"\n              ]\n            }\n          },\n          \"position\": {\n            \"x\": 0,\n            \"y\": 5,\n            \"width\": 6,\n            \"height\": 2\n          }\n        },\n        {\n          \"widget\": {\n            \"name\": \"line_valid_readings_by_day\",\n            \"queries\": [\n              {\n                \"name\": \"main_query\",\n                \"query\": {\n                  \"datasetName\": \"ds_device_ingestion_timeseries\",\n                  \"fields\": [\n                    {\n                      \"name\": \"daily(date)\",\n                      \"expression\": \"DATE_TRUNC(\\\"DAY\\\", `date`)\"\n                    },\n                    {\n                      \"name\": \"device_type\",\n                      \"expression\": \"`device_type`\"\n                    },\n                    {\n                      \"name\": \"sum(readings_valid)\",\n                      \"expression\": \"SUM(`readings_valid`)\"\n                    }\n                  ],\n                  \"disaggregated\": false\n                }\n              }\n            ],\n            \"spec\": {\n              \"version\": 3,\n              \"widgetType\": \"line\",\n              \"encodings\": {\n                \"x\": {\n                  \"fieldName\": \"daily(date)\",\n                  \"scale\": {\n                    \"type\": \"temporal\"\n                  },\n                  \"axis\": {\n                    \"title\": \"Date\"\n                  },\n                  \"displayName\": \"Date\"\n                },\n                \"y\": {\n                  \"fieldName\": \"sum(readings_valid)\",\n                  \"scale\": {\n                    \"type\": \"quantitative\"\n                  },\n                  \"axis\": {\n                    \"title\": \"Valid Readings\"\n                  },\n                  \"displayName\": \"Valid Readings\"\n                },\n                \"color\": {\n                  \"fieldName\": \"device_type\",\n                  \"scale\": {\n                    \"type\": \"categorical\"\n                  },\n                  \"displayName\": \"Device Type\"\n                }\n              },\n              \"frame\": {\n                \"showTitle\": true,\n                \"title\": \"Valid Readings by Day (All Devices)\",\n                \"description\": \"X: date; Y: valid readings; line color: device_type. Glucose and BP show post-rollout drop; weight remains stable.\"\n              }\n            }\n          },\n          \"position\": {\n            \"x\": 0,\n            \"y\": 7,\n            \"width\": 3,\n            \"height\": 5\n          }\n        },\n        {\n          \"widget\": {\n            \"name\": \"line_bp_diastolic_missing_rate_by_region\",\n            \"queries\": [\n              {\n                \"name\": \"main_query\",\n                \"query\": {\n                  \"datasetName\": \"ds_bp_quality_timeseries\",\n                  \"fields\": [\n                    {\n                      \"name\": \"daily(date)\",\n                      \"expression\": \"DATE_TRUNC(\\\"DAY\\\", `date`)\"\n                    },\n                    {\n                      \"name\": \"region\",\n                      \"expression\": \"`region`\"\n                    },\n                    {\n                      \"name\": \"avg(missing_rate_diastolic)\",\n                      \"expression\": \"AVG(`missing_rate_diastolic`)\"\n                    }\n                  ],\n                  \"disaggregated\": false\n                }\n              }\n            ],\n            \"spec\": {\n              \"version\": 3,\n              \"widgetType\": \"line\",\n              \"encodings\": {\n                \"x\": {\n                  \"fieldName\": \"daily(date)\",\n                  \"scale\": {\n                    \"type\": \"temporal\"\n                  },\n                  \"axis\": {\n                    \"title\": \"Date\"\n                  },\n                  \"displayName\": \"Date\"\n                },\n                \"y\": {\n                  \"fieldName\": \"avg(missing_rate_diastolic)\",\n                  \"scale\": {\n                    \"type\": \"quantitative\"\n                  },\n                  \"format\": {\n                    \"type\": \"number-percent\",\n                    \"decimalPlaces\": {\n                      \"type\": \"max\",\n                      \"places\": 1\n                    }\n                  },\n                  \"axis\": {\n                    \"title\": \"BP Diastolic Missing Rate (%)\"\n                  },\n                  \"displayName\": \"Missing Rate (%)\"\n                },\n                \"color\": {\n                  \"fieldName\": \"region\",\n                  \"scale\": {\n                    \"type\": \"categorical\"\n                  },\n                  \"displayName\": \"Region\"\n                }\n              },\n              \"frame\": {\n                \"showTitle\": true,\n                \"title\": \"BP Diastolic Missing Rate (Daily) by Region\",\n                \"description\": \"Central/West spike after 2025-10-02; recovery after 2025-10-12; residual weekend gaps until 2025-10-21.\"\n              }\n            }\n          },\n          \"position\": {\n            \"x\": 3,\n            \"y\": 7,\n            \"width\": 3,\n            \"height\": 5\n          }\n        },\n        {\n          \"widget\": {\n            \"name\": \"bar_risk_score_distribution_weekly\",\n            \"queries\": [\n              {\n                \"name\": \"main_query\",\n                \"query\": {\n                  \"datasetName\": \"ds_patient_risk_weekly\",\n                  \"fields\": [\n                    {\n                      \"name\": \"weekly(week_start)\",\n                      \"expression\": \"DATE_TRUNC(\\\"WEEK\\\", `week_start`)\"\n                    },\n                    {\n                      \"name\": \"risk_tier\",\n                      \"expression\": \"`risk_tier`\"\n                    },\n                    {\n                      \"name\": \"avg(avg_risk_score)\",\n                      \"expression\": \"AVG(`avg_risk_score`)\"\n                    }\n                  ],\n                  \"disaggregated\": false\n                }\n              }\n            ],\n            \"spec\": {\n              \"version\": 3,\n              \"widgetType\": \"bar\",\n              \"encodings\": {\n                \"x\": {\n                  \"fieldName\": \"weekly(week_start)\",\n                  \"scale\": {\n                    \"type\": \"temporal\"\n                  },\n                  \"axis\": {\n                    \"title\": \"Week Start\"\n                  },\n                  \"displayName\": \"Week Start\"\n                },\n                \"y\": {\n                  \"fieldName\": \"avg(avg_risk_score)\",\n                  \"scale\": {\n                    \"type\": \"quantitative\"\n                  },\n                  \"axis\": {\n                    \"title\": \"Avg Risk Score\"\n                  },\n                  \"displayName\": \"Avg Risk Score\"\n                },\n                \"color\": {\n                  \"fieldName\": \"risk_tier\",\n                  \"scale\": {\n                    \"type\": \"categorical\"\n                  },\n                  \"displayName\": \"Risk Tier\"\n                }\n              },\n              \"frame\": {\n                \"showTitle\": true,\n                \"title\": \"Risk Score Distribution by Tier (Weekly)\",\n                \"description\": \"Grouped bars by risk tier show incident elevation in high-risk and normalization post 2025-10-21.\"\n              },\n              \"mark\": {\n                \"layout\": \"group\"\n              }\n            }\n          },\n          \"position\": {\n            \"x\": 0,\n            \"y\": 12,\n            \"width\": 3,\n            \"height\": 5\n          }\n        },\n        {\n          \"widget\": {\n            \"name\": \"line_encounter_diet_non_adherence_daily\",\n            \"queries\": [\n              {\n                \"name\": \"main_query\",\n                \"query\": {\n                  \"datasetName\": \"ds_encounter_signal_timeseries\",\n                  \"fields\": [\n                    {\n                      \"name\": \"daily(date)\",\n                      \"expression\": \"DATE_TRUNC(\\\"DAY\\\", `date`)\"\n                    },\n                    {\n                      \"name\": \"region\",\n                      \"expression\": \"`region`\"\n                    },\n                    {\n                      \"name\": \"avg(pct_notes_with_diet_non_adherence)\",\n                      \"expression\": \"AVG(`pct_notes_with_diet_non_adherence`)\"\n                    }\n                  ],\n                  \"disaggregated\": false\n                }\n              }\n            ],\n            \"spec\": {\n              \"version\": 3,\n              \"widgetType\": \"line\",\n              \"encodings\": {\n                \"x\": {\n                  \"fieldName\": \"daily(date)\",\n                  \"scale\": {\n                    \"type\": \"temporal\"\n                  },\n                  \"axis\": {\n                    \"title\": \"Date\"\n                  },\n                  \"displayName\": \"Date\"\n                },\n                \"y\": {\n                  \"fieldName\": \"avg(pct_notes_with_diet_non_adherence)\",\n                  \"scale\": {\n                    \"type\": \"quantitative\"\n                  },\n                  \"format\": {\n                    \"type\": \"number-percent\",\n                    \"decimalPlaces\": {\n                      \"type\": \"max\",\n                      \"places\": 1\n                    }\n                  },\n                  \"axis\": {\n                    \"title\": \"Diet Non-Adherence (%)\"\n                  },\n                  \"displayName\": \"Diet Non-Adherence (%)\"\n                },\n                \"color\": {\n                  \"fieldName\": \"region\",\n                  \"scale\": {\n                    \"type\": \"categorical\"\n                  },\n                  \"displayName\": \"Region\"\n                }\n              },\n              \"frame\": {\n                \"showTitle\": true,\n                \"title\": \"Encounter Signals - Diet Non-Adherence (Daily)\",\n                \"description\": \"Summarization uptick to ~27–31% during rollout window.\"\n              }\n            }\n          },\n          \"position\": {\n            \"x\": 3,\n            \"y\": 12,\n            \"width\": 3,\n            \"height\": 5\n          }\n        },\n        {\n          \"widget\": {\n            \"name\": \"bar_care_actions_mix_weekly\",\n            \"queries\": [\n              {\n                \"name\": \"main_query\",\n                \"query\": {\n                  \"datasetName\": \"ds_care_actions_weekly\",\n                  \"fields\": [\n                    {\n                      \"name\": \"weekly(week_start)\",\n                      \"expression\": \"DATE_TRUNC(\\\"WEEK\\\", `week_start`)\"\n                    },\n                    {\n                      \"name\": \"action_type\",\n                      \"expression\": \"`action_type`\"\n                    },\n                    {\n                      \"name\": \"sum(actions_executed)\",\n                      \"expression\": \"SUM(`actions_executed`)\"\n                    }\n                  ],\n                  \"disaggregated\": false\n                }\n              }\n            ],\n            \"spec\": {\n              \"version\": 3,\n              \"widgetType\": \"bar\",\n              \"encodings\": {\n                \"x\": {\n                  \"fieldName\": \"weekly(week_start)\",\n                  \"scale\": {\n                    \"type\": \"temporal\"\n                  },\n                  \"axis\": {\n                    \"title\": \"Week Start\"\n                  },\n                  \"displayName\": \"Week Start\"\n                },\n                \"y\": {\n                  \"fieldName\": \"sum(actions_executed)\",\n                  \"scale\": {\n                    \"type\": \"quantitative\"\n                  },\n                  \"axis\": {\n                    \"title\": \"Actions Executed\"\n                  },\n                  \"displayName\": \"Actions Executed\"\n                },\n                \"color\": {\n                  \"fieldName\": \"action_type\",\n                  \"scale\": {\n                    \"type\": \"categorical\"\n                  },\n                  \"displayName\": \"Action Type\"\n                }\n              },\n              \"frame\": {\n                \"showTitle\": true,\n                \"title\": \"Care Actions Mix by Region (Weekly)\",\n                \"description\": \"Stacked action types show pivot toward nurse outreach and medication review.\",\n                \"showDescription\": true\n              }\n            }\n          },\n          \"position\": {\n            \"x\": 0,\n            \"y\": 17,\n            \"width\": 3,\n            \"height\": 5\n          }\n        },\n        {\n          \"widget\": {\n            \"name\": \"bar_cumulative_cost_exposure_by_region\",\n            \"queries\": [\n              {\n                \"name\": \"main_query\",\n                \"query\": {\n                  \"datasetName\": \"ds_cumulative_care_cost\",\n                  \"fields\": [\n                    {\n                      \"name\": \"daily(date)\",\n                      \"expression\": \"DATE_TRUNC(\\\"DAY\\\", `date`)\"\n                    },\n                    {\n                      \"name\": \"region\",\n                      \"expression\": \"`region`\"\n                    },\n                    {\n                      \"name\": \"sum(running_total_cost_usd)\",\n                      \"expression\": \"SUM(`running_total_cost_usd`)\"\n                    }\n                  ],\n                  \"disaggregated\": false\n                }\n              }\n            ],\n            \"spec\": {\n              \"version\": 3,\n              \"widgetType\": \"bar\",\n              \"encodings\": {\n                \"x\": {\n                  \"fieldName\": \"daily(date)\",\n                  \"scale\": {\n                    \"type\": \"temporal\"\n                  },\n                  \"axis\": {\n                    \"title\": \"Date\"\n                  },\n                  \"displayName\": \"Date\"\n                },\n                \"y\": {\n                  \"fieldName\": \"sum(running_total_cost_usd)\",\n                  \"scale\": {\n                    \"type\": \"quantitative\"\n                  },\n                  \"format\": {\n                    \"type\": \"number-currency\",\n                    \"currencyCode\": \"USD\",\n                    \"abbreviation\": \"compact\",\n                    \"decimalPlaces\": {\n                      \"type\": \"max\",\n                      \"places\": 0\n                    }\n                  },\n                  \"axis\": {\n                    \"title\": \"Cumulative Cost Exposure ($)\"\n                  },\n                  \"displayName\": \"Cumulative Cost Exposure ($)\"\n                },\n             