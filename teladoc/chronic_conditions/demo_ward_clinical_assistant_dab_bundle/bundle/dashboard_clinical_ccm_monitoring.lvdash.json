      "layout": [
        {
          "widget": {
            "name": "header_main",
            "multilineTextboxSpec": {
              "lines": [
                "# Chronic Care Ops & Risk Monitoring\n",
                "Executive monitoring of ingestion quality, encounter signals, risk, and care workload during the 2025-10-02..2025-10-21 firmware anomaly and staged recovery.\n"
              ]
            }
          },
          "position": {
            "x": 0,
            "y": 0,
            "width": 6,
            "height": 2
          }
        },
        {
          "widget": {
            "name": "kpi_active_patients",
            "queries": [
              {
                "name": "main_query",
