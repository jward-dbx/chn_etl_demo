{
  "datasets": [
    {
      "name": "ds_patients_active_counter",
      "displayName": "KPI: Active CCM Patients",
      "queryLines": [
        "SELECT active_ccm_patients FROM ward_demo.gold.gold_counter_active_patients ORDER BY active_ccm_patients DESC "
      ]
    },
    {
      "name": "ds_valid_readings_last7_counter",
      "displayName": "KPI: Valid Readings Last 7 Days",
      "queryLines": [
        "SELECT valid_readings_last7 FROM ward_demo.gold.gold_counter_valid_readings_last7 ORDER BY valid_readings_last7 DESC "
      ]
    },
    {
      "name": "ds_avg_daily_risk_high_last7_counter",
      "displayName": "KPI: Avg Daily Risk (High Tier, Last 7)",
      "queryLines": [
        "SELECT avg_daily_risk_high_last7 FROM ward_demo.gold.gold_counter_avg_daily_risk_high_last7 ORDER BY avg_daily_risk_high_last7 DESC "
      ]
    },
    {
      "name": "ds_care_actions_executed_last14_counter",
      "displayName": "KPI: Care Actions Executed Last 14 Days",
      "queryLines": [
        "SELECT actions_executed_last14 FROM ward_demo.gold.gold_counter_care_actions_executed_last14 ORDER BY actions_executed_last14 DESC "
      ]
    },
    {
      "name": "ds_device_ingestion_timeseries",
      "displayName": "Device Ingestion Timeseries",
      "queryLines": [
        "SELECT date, region, device_type, readings_total, readings_valid, valid_rate, CASE WHEN date BETWEEN DATE('2025-10-02') AND DATE('2025-10-21') THEN true ELSE false END AS is_anomaly_window FROM ward_demo.gold.gold_device_ingestion_timeseries ORDER BY date ASC, device_type ASC, region ASC "
      ]
    },
    {
      "name": "ds_bp_quality_timeseries",
      "displayName": "BP Quality Timeseries",
      "queryLines": [
        "SELECT date, region, bp_readings, diastolic_missing, missing_rate_diastolic, CASE WHEN date BETWEEN DATE('2025-10-02') AND DATE('2025-10-21') THEN true ELSE false END AS is_anomaly_window FROM ward_demo.gold.gold_bp_quality_timeseries ORDER BY date ASC, region ASC "
      ]
    },
    {
      "name": "ds_patient_risk_weekly",
      "displayName": "Patient Risk Weekly",
      "queryLines": [
        "SELECT week_start, region, risk_tier, condition, avg_risk_score, patient_days FROM ward_demo.gold.gold_patient_risk_weekly ORDER BY week_start ASC, region ASC, risk_tier ASC "
      ]
    },
    {
      "name": "ds_encounter_signal_timeseries",
      "displayName": "Encounter Signals Timeseries",
      "queryLines": [
        "SELECT date, region, pct_notes_with_diet_non_adherence, pct_notes_with_med_adherence_issues, notes_count, CASE WHEN date BETWEEN DATE('2025-10-02') AND DATE('2025-10-21') THEN true ELSE false END AS is_anomaly_window FROM ward_demo.gold.gold_encounter_signal_timeseries ORDER BY date ASC, region ASC "
      ]
    },
    {
      "name": "ds_care_actions_weekly",
      "displayName": "Care Actions Weekly",
      "queryLines": [
        "SELECT week_start, region, condition, action_type, actions_total, actions_executed, execute_rate, avg_cost_usd, (actions_executed * avg_cost_usd) AS executed_cost_usd_est FROM ward_demo.gold.gold_care_actions_weekly ORDER BY week_start ASC, region ASC, action_type ASC "
      ]
    },
    {
      "name": "ds_device_change_log",
      "displayName": "Device Change Log",
      "queryLines": [
        "SELECT change_date, date, vendor, device_type, version, regions_scope, change_type, error_codes, notes FROM ward_demo.silver.silver_device_change_log ORDER BY change_date DESC "
      ]
    },
    {
      "name": "ds_cumulative_care_cost",
      "displayName": "Cumulative Care Cost",
      "queryLines": [
        "SELECT date, region, condition, executed_cost_usd, running_total_cost_usd FROM ward_demo.gold.gold_cumulative_care_cost ORDER BY date ASC, region ASC "
      ]
    }
  ],
  "pages": [
